// =============================================
// SPI Dual Mode Core - Auto-generated by SPI Customizer
// Supports both Master and Slave functionality
// =============================================

module spi_dual #(
    parameter MODE = {{MODE}},                    // SPI mode (0, 1, 2, 3)
    parameter DATA_WIDTH = {{DATA_WIDTH}},        // Data width in bits
    parameter NUM_SLAVES = {{NUM_SLAVES}},        // Number of slaves when in master mode
    parameter SELECTED_SLAVE = {{ SELECTED_SLAVE }},                 // Selected slave index for deterministic one-hot SS
    parameter SLAVE_ACTIVE_LOW = {{SLAVE_ACTIVE_LOW|int}},  // Slave select polarity
    parameter MSB_FIRST = {{MSB_FIRST|int}},  // Data order
    parameter FIFO_DEPTH = {{FIFO_DEPTH}},        // FIFO buffer depth
    parameter MAX_SLAVES = {{MAX_SLAVES}},        // Maximum slaves supported
    parameter CLOCK_DIVIDER = {{CLOCK_DIVIDER}},  // System clock divider
    parameter DEFAULT_DATA_ENABLED = {{DEFAULT_DATA_ENABLED|int}},
    parameter DEFAULT_DATA_VALUE = {{DATA_WIDTH}}'h{{DEFAULT_DATA_VALUE}}
)(
    // System signals
    input  wire clk,                    // System clock
    input  wire rst_n,                  // Active-low reset

    // Mode selection
    input  wire master_mode,            // 1 = Master, 0 = Slave

    // Master Interface (when master_mode = 1)
    output wire sclk,                   // SPI clock output
    output wire mosi,                   // Master Out Slave In
    input  wire miso,                   // Master In Slave Out
    output wire [NUM_SLAVES-1:0] ss_n,  // Slave Select outputs

    // Slave Interface (when master_mode = 0)
    input  wire sclk_in,                // SPI clock input
    input  wire mosi_in,                // MOSI input
    output wire miso_out,               // MISO output
    input  wire ss_in,                  // Slave Select input

    // Common Data Interface
    output wire [DATA_WIDTH-1:0] rx_data,  // Received data
    input  wire [DATA_WIDTH-1:0] tx_data,  // Data to transmit
    output wire rx_valid,               // Receive data valid
    output wire tx_ready,               // Ready to accept new transmit data
    input  wire tx_valid,               // Transmit data valid

    // Control and status
    output wire busy,                   // SPI transaction in progress
    output wire irq,                    // Interrupt request
    input  wire irq_clear               // Clear interrupt
);

    // Internal signals
    localparam SLAVE_TIMEOUT_CYCLES = 8'd200; // Timeout after ~200 system clock cycles
    localparam CPOL = (MODE == 2 || MODE == 3) ? 1 : 0; // Clock polarity: 1=idles high
    localparam SAMPLE_ON_RISING = (MODE == 0 || MODE == 3) ? 1 : 0; // 1=sample rising, 0=sample falling
    localparam SS_ACTIVE = SLAVE_ACTIVE_LOW ? 1'b0 : 1'b1;
    localparam integer SELECTED_SLAVE_CLAMP = (SELECTED_SLAVE >= 0 && SELECTED_SLAVE < NUM_SLAVES) ? SELECTED_SLAVE : 0;
    reg [DATA_WIDTH-1:0] default_data;

    // Master mode internal signals
    reg master_start_tx, master_start_rx;
    reg [DATA_WIDTH-1:0] master_tx_shift_reg, master_rx_shift_reg;
    reg [7:0] master_bit_counter;
    reg [7:0] master_sclk_counter;
    reg master_busy, master_sclk_en;
    reg [NUM_SLAVES-1:0] master_ss_n_reg;
    reg [DATA_WIDTH-1:0] master_rx_data_buffer;
    reg master_rx_valid_buffer, master_tx_ready_buffer;

    // Slave mode internal signals
    reg slave_rx_valid_buffer, slave_tx_ready_buffer, slave_busy_buffer;
    reg [DATA_WIDTH-1:0] slave_rx_data_buffer;
    reg [DATA_WIDTH-1:0] slave_tx_shift_reg;
    reg [7:0] slave_bit_counter;
    reg slave_sclk_last_state, slave_ss_last_state;
    reg slave_transaction_active;
    reg [7:0] slave_timeout_counter;

    // Default data initialization
    initial begin
        default_data <= DEFAULT_DATA_VALUE;
    end

    // Master mode implementation
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            master_busy <= 1'b0;
            master_sclk_en <= 1'b0;
            master_start_tx <= 1'b0;
            master_start_rx <= 1'b0;
            master_tx_ready_buffer <= 1'b1; // Ready to accept data initially
            master_rx_valid_buffer <= 1'b0;
            master_bit_counter <= 8'd0;
            master_sclk_counter <= 8'd0;
            master_tx_shift_reg <= {DATA_WIDTH{1'b0}};
            master_rx_shift_reg <= {DATA_WIDTH{1'b0}};
            master_ss_n_reg <= {NUM_SLAVES{~SS_ACTIVE}}; // Deasserted based on selected polarity
        end else if (master_mode) begin
            // Master mode logic
            if (tx_valid && master_tx_ready_buffer && !master_busy) begin
                // Start new transmission
                master_tx_shift_reg <= tx_data;
                master_tx_ready_buffer <= 1'b0; // Not ready during transmission
                master_busy <= 1'b1;
                master_sclk_en <= 1'b1;
                master_bit_counter <= 8'd0;
                master_sclk_counter <= 8'd0;
                master_start_tx <= 1'b1;
                // Deterministic one-hot selection using SELECTED_SLAVE
                master_ss_n_reg <= {NUM_SLAVES{~SS_ACTIVE}};
                master_ss_n_reg[SELECTED_SLAVE_CLAMP] <= SS_ACTIVE;
            end else begin
                master_start_tx <= 1'b0;
            end

            // SPI clock generation and data shifting
            if (master_busy && master_sclk_en) begin
                master_sclk_counter <= master_sclk_counter + 1'b1;

                // Generate SPI clock (divide by CLOCK_DIVIDER)
                if (master_sclk_counter >= CLOCK_DIVIDER) begin
                    master_sclk_counter <= 8'd0;

                    // SPI Mode 0: Sample on rising edge, change on falling edge
                    // For simplicity, we'll toggle and sample on each clock edge
                    if (master_bit_counter < DATA_WIDTH) begin
                        // Shift data
                        if (MSB_FIRST) begin
                            if (DATA_WIDTH > 1) begin
                                master_tx_shift_reg <= {master_tx_shift_reg[DATA_WIDTH-2:0], 1'b0};
                            end else begin
                                master_tx_shift_reg <= 1'b0;  // For 1-bit, just set to 0 after transmission
                            end
                        end else begin
                            if (DATA_WIDTH > 1) begin
                                master_tx_shift_reg <= {1'b0, master_tx_shift_reg[DATA_WIDTH-1:1]};
                            end else begin
                                master_tx_shift_reg <= 1'b0;  // For 1-bit, just set to 0 after transmission
                            end
                        end
                        master_bit_counter <= master_bit_counter + 1'b1;
                    end else begin
                        // Transmission complete
                        master_busy <= 1'b0;
                        master_sclk_en <= 1'b0;
                        master_tx_ready_buffer <= 1'b1; // Ready for next transmission
                        master_rx_valid_buffer <= 1'b1; // Data received
                        master_rx_data_buffer <= master_rx_shift_reg;
                        master_ss_n_reg <= {NUM_SLAVES{~SS_ACTIVE}}; // Deassert slave select
                    end
                end
            end
        end
    end

    // Slave mode implementation - proper SPI protocol handling
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            slave_busy_buffer <= 1'b0;
            slave_rx_valid_buffer <= 1'b0;
            slave_tx_ready_buffer <= 1'b0;
            slave_rx_data_buffer <= {DATA_WIDTH{1'b0}};
            slave_tx_shift_reg <= default_data;
            slave_bit_counter <= 8'd0;
            slave_sclk_last_state <= CPOL[0]; // Initialize to CPOL idle state
            slave_ss_last_state <= ~SS_ACTIVE;
            slave_transaction_active <= 1'b0;
            slave_timeout_counter <= 8'd0;
        end else if (!master_mode) begin
            // Detect SS transitions
            slave_ss_last_state <= ss_in;

            // Start transaction on SS falling edge
            if ((slave_ss_last_state != SS_ACTIVE) && (ss_in == SS_ACTIVE)) begin
                slave_transaction_active <= 1'b1;
                slave_busy_buffer <= 1'b1;
                slave_bit_counter <= 8'd0;
                slave_tx_shift_reg <= tx_data; // Load data to transmit
                slave_tx_ready_buffer <= 1'b0; // Not ready for new data during transaction
            end

            // End transaction on SS rising edge
            if ((slave_ss_last_state == SS_ACTIVE) && (ss_in != SS_ACTIVE) && slave_transaction_active) begin
                slave_transaction_active <= 1'b0;
                slave_busy_buffer <= 1'b0;
                slave_rx_valid_buffer <= 1'b1; // Data received
                slave_tx_ready_buffer <= 1'b1; // Ready for new transmit data
            end

            // Handle SPI clock edges during active transaction
            if (slave_transaction_active) begin
                slave_sclk_last_state <= sclk_in;
                slave_timeout_counter <= slave_timeout_counter + 1'b1;

                // Timeout mechanism - force completion after ~200 clock cycles
                if (slave_timeout_counter > SLAVE_TIMEOUT_CYCLES) begin
                    slave_transaction_active <= 1'b0;
                    slave_busy_buffer <= 1'b0;
                    slave_rx_valid_buffer <= 1'b1; // Data received (partial)
                    slave_tx_ready_buffer <= 1'b1; // Ready for new transmit data
                    slave_timeout_counter <= 8'd0;
                end else begin
                    // Sample on the correct edge based on SPI mode
                    // SAMPLE_ON_RISING=1 for modes 0,3; =0 for modes 1,2
                    if (SAMPLE_ON_RISING ? (!slave_sclk_last_state && sclk_in) : (slave_sclk_last_state && !sclk_in)) begin
                    // Sample MOSI data
                    if (MSB_FIRST) begin
                        if (DATA_WIDTH > 1) begin
                            slave_rx_data_buffer <= {slave_rx_data_buffer[DATA_WIDTH-2:0], mosi_in};
                        end else begin
                            slave_rx_data_buffer <= mosi_in;  // For 1-bit, just set to received bit
                        end
                    end else begin
                        if (DATA_WIDTH > 1) begin
                            slave_rx_data_buffer <= {mosi_in, slave_rx_data_buffer[DATA_WIDTH-1:1]};
                        end else begin
                            slave_rx_data_buffer <= mosi_in;  // For 1-bit, just set to received bit
                        end
                    end
                        slave_bit_counter <= slave_bit_counter + 1'b1;

                        // Auto-complete transaction after all bits received
                        if (slave_bit_counter >= DATA_WIDTH) begin
                            slave_transaction_active <= 1'b0;
                            slave_busy_buffer <= 1'b0;
                            slave_rx_valid_buffer <= 1'b1; // Data received
                            slave_tx_ready_buffer <= 1'b1; // Ready for new transmit data
                            slave_timeout_counter <= 8'd0;
                        end
                    end
                end
                // Note: MISO changes on falling edge would be handled here if needed
            end else begin
                // Not in transaction
                slave_rx_valid_buffer <= 1'b0;
                slave_tx_ready_buffer <= 1'b1;
                slave_timeout_counter <= 8'd0;
            end
        end
    end

    // Output signal selection based on master_mode
    // SCLK idles at CPOL level; XOR with CPOL inverts the counter parity for correct polarity
    assign sclk = master_mode ? (master_sclk_en ? (master_sclk_counter[0] ^ (CPOL ? 1'b1 : 1'b0)) : (CPOL ? 1'b1 : 1'b0)) : 1'b0;
    assign mosi = master_mode ? master_tx_shift_reg[MSB_FIRST ? DATA_WIDTH-1 : 0] : 1'b0;
    assign miso_out = master_mode ? 1'b0 : (slave_tx_ready_buffer ? default_data[MSB_FIRST ? DATA_WIDTH-1 : 0] : 1'b0);

    // Slave select outputs follow configured polarity.
    assign ss_n = master_mode ? master_ss_n_reg : {NUM_SLAVES{~SS_ACTIVE}};

    // Data signal selection
    assign rx_data = master_mode ? master_rx_data_buffer : slave_rx_data_buffer;
    assign rx_valid = master_mode ? master_rx_valid_buffer : slave_rx_valid_buffer;
    assign tx_ready = master_mode ? master_tx_ready_buffer : slave_tx_ready_buffer;
    assign busy = master_mode ? master_busy : slave_busy_buffer;

    // Simplified output assignments
    assign irq = 1'b0;  // No interrupts for now

endmodule
