// =============================================
// SPI Dual Mode Testbench - Auto-generated by SPI Customizer
// =============================================

`timescale 1ns / 1ps

module spi_dual_tb;

    // Parameters
    parameter MODE = {{ mode }};
    parameter DATA_WIDTH = {{ data_width }};
    parameter NUM_SLAVES = {{ num_slaves }};
    parameter SELECTED_SLAVE = {{ selected_slave }};
    parameter SLAVE_ACTIVE_LOW = {{ slave_active_low | int }};
    parameter MSB_FIRST = {{ msb_first | int }};
    parameter FIFO_DEPTH = {{ fifo_depth }};
    parameter MAX_SLAVES = {{ max_slaves }};
    parameter CLOCK_DIVIDER = {{ clock_divider }};
    parameter DEFAULT_DATA_ENABLED = {{ default_data_enabled | int }};
    parameter DEFAULT_DATA_VALUE = {{ data_width }}'h{{ default_data_value }};
    localparam SS_ACTIVE = SLAVE_ACTIVE_LOW ? 1'b0 : 1'b1;
    localparam SS_INACTIVE = ~SS_ACTIVE;
    localparam CPOL = (MODE == 2 || MODE == 3) ? 1'b1 : 1'b0;
    localparam CPHA = (MODE == 1 || MODE == 3) ? 1'b1 : 1'b0;
    localparam integer SLAVE_TEST_BITS = DATA_WIDTH;
    localparam [DATA_WIDTH-1:0] SLAVE_TEST_WORD = {{ data_width }}'h{{ '5A' * ((data_width + 7) // 8) }};

    // Signals
    reg clk;
    reg rst_n;
    reg master_mode;
    wire sclk;
    wire mosi;
    reg miso;
    wire [NUM_SLAVES-1:0] ss_n;
    reg sclk_in;
    reg mosi_in;
    wire miso_out;
    reg ss_in;
    reg [DATA_WIDTH-1:0] tx_data;
    wire [DATA_WIDTH-1:0] rx_data;
    wire rx_valid;
    wire tx_ready;
    reg tx_valid;
    wire busy;
    wire irq;
    integer i;
    reg [DATA_WIDTH-1:0] expected_slave_rx;
    reg [7:0] timeout_cycles;
    reg slave_rx_valid_seen;

    // DUT instantiation
    spi_dual #(
        .MODE(MODE),
        .DATA_WIDTH(DATA_WIDTH),
        .NUM_SLAVES(NUM_SLAVES),
        .SELECTED_SLAVE(SELECTED_SLAVE),
        .SLAVE_ACTIVE_LOW(SLAVE_ACTIVE_LOW),
        .MSB_FIRST(MSB_FIRST),
        .FIFO_DEPTH(FIFO_DEPTH),
        .MAX_SLAVES(MAX_SLAVES),
        .CLOCK_DIVIDER(CLOCK_DIVIDER),
        .DEFAULT_DATA_ENABLED(DEFAULT_DATA_ENABLED),
        .DEFAULT_DATA_VALUE(DEFAULT_DATA_VALUE)
    ) dut (
        .clk(clk),
        .rst_n(rst_n),
        .master_mode(master_mode),
        .sclk(sclk),
        .mosi(mosi),
        .miso(miso),
        .ss_n(ss_n),
        .sclk_in(sclk_in),
        .mosi_in(mosi_in),
        .miso_out(miso_out),
        .ss_in(ss_in),
        .rx_data(rx_data),
        .tx_data(tx_data),
        .rx_valid(rx_valid),
        .tx_ready(tx_ready),
        .tx_valid(tx_valid),
        .busy(busy),
        .irq(irq),
        .irq_clear(1'b0)
    );

    // Clock generation
    initial begin
        clk = 0;
        forever #10 clk = ~clk;  // 50MHz clock
    end

    // Test sequence for dual mode
    initial begin
        // Initialize
        rst_n = 0;
        master_mode = 1;  // Start in master mode
        tx_data = 0;
        tx_valid = 0;
        miso = 0;
        sclk_in = CPOL; // CPOL idle state
        mosi_in = 0;
        ss_in = SS_INACTIVE;
        slave_rx_valid_seen = 0;

        #100;
        rst_n = 1;
        #200;  // Allow system to stabilize

        $display("=== SPI Dual Mode RTL Testbench Starting ===");
        $display("Configuration: Mode %d, %d-bit data, Dual mode", MODE, DATA_WIDTH);

        // Test master mode first
        $display("--- Testing Master Mode ---");

        // Test basic transmission in master mode
        tx_data = {{ data_width }}'h{{ 'A5' * ((data_width + 7) // 8) }};
        $display("TX Data: 0x%h", tx_data);

        // Wait for tx_ready to be asserted (may already be high)
        wait(tx_ready);
        #10; // Small delay
        tx_valid = 1; // Assert tx_valid to start transmission
        #20; // Hold tx_valid for a few cycles
        tx_valid = 0; // Deassert tx_valid
        #100;
        if (!busy) begin
            $fatal(1, "Master busy did not assert in dual master transaction");
        end
        if (ss_n[SELECTED_SLAVE] !== SS_ACTIVE) begin
            $fatal(1, "Selected SS index %0d not active in dual master transaction", SELECTED_SLAVE);
        end

        // Wait for transmission to complete (with timeout)
        begin : wait_master
            localparam MASTER_TX_TIMEOUT_CYCLES = 5000;
            integer timeout;
            timeout = 0;
            while (!tx_ready && timeout < MASTER_TX_TIMEOUT_CYCLES) begin
                #20;
                timeout = timeout + 1;
            end
            if (timeout >= MASTER_TX_TIMEOUT_CYCLES) begin
                $fatal(1, "Master transmission timeout");
            end else begin
                $display("Master transmission complete");
            end
        end

        // Switch to slave mode after master test
        #500;
        master_mode = 0;
        $display("--- Switched to Slave Mode ---");

        // Test slave mode with proper SPI master simulation
        #100;

        // Simulate a complete SPI transaction as master to our slave
        $display("Simulating SPI master transaction to test slave mode");

        // Start transaction: assert SS active level
        ss_in = SS_ACTIVE;
        $display("Slave selected (SS active=%0b)", SS_ACTIVE);

        // SPI Mode {{ mode }}: CPOL={{ 1 if mode >= 2 else 0 }}, CPHA={{ 1 if mode in [1,3] else 0 }}
        // Sampling occurs on {{ 'falling' if mode in [1,2] else 'rising' }} edge
        // Send full DATA_WIDTH transaction and expect exact match.
        expected_slave_rx = SLAVE_TEST_WORD;

        // CPHA-aware external-master drive:
        // - CPHA=0: set MOSI before leading edge so slave samples on leading edge.
        // - CPHA=1: change MOSI on leading edge so slave samples on trailing edge.
        for (i = 0; i < SLAVE_TEST_BITS; i = i + 1) begin
            if (!CPHA) begin
                if (MSB_FIRST)
                    mosi_in = SLAVE_TEST_WORD[DATA_WIDTH - 1 - i];
                else
                    mosi_in = SLAVE_TEST_WORD[i];
                #50;
                sclk_in = ~CPOL; // Leading edge
                #50;
                sclk_in = CPOL;  // Trailing edge
            end else begin
                #50;
                sclk_in = ~CPOL; // Leading edge
                if (MSB_FIRST)
                    mosi_in = SLAVE_TEST_WORD[DATA_WIDTH - 1 - i];
                else
                    mosi_in = SLAVE_TEST_WORD[i];
                #50;
                sclk_in = CPOL;  // Trailing edge (sampling edge for CPHA=1)
            end
        end

        // Return clock to idle
        sclk_in = CPOL;

        // End transaction: deassert SS
        #100;
        ss_in = SS_INACTIVE;
        $display("Slave mode SPI transaction complete - sent 0x%0h (%0d bits)", SLAVE_TEST_WORD, SLAVE_TEST_BITS);

        #200; // Allow slave to process

        // Wait for slave rx_valid pulse with timeout, then check payload
        timeout_cycles = 0;
        while (!slave_rx_valid_seen && timeout_cycles < 100) begin
            #20;
            timeout_cycles = timeout_cycles + 1;
        end
        if (!slave_rx_valid_seen) begin
            $fatal(1, "Slave rx_valid did not assert within timeout");
        end

        if (rx_data !== expected_slave_rx) begin
            $fatal(1, "Slave RX mismatch. expected=0x%h got=0x%h", expected_slave_rx, rx_data);
        end else begin
            $display("Slave RX matched expected payload: 0x%h", rx_data);
        end

        $display("=== All Dual Mode Tests Completed Successfully ===");
        #100; // Small delay before finish
        $finish;
    end

    // Latch rx_valid pulse so the check is robust to single-cycle assertions
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            slave_rx_valid_seen <= 1'b0;
        else if (rx_valid)
            slave_rx_valid_seen <= 1'b1;
    end

    // VCD dumping
    initial begin
        $dumpfile("{{ vcd_filename }}");
        $dumpvars(0, spi_dual_tb);
    end

endmodule
